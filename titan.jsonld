  "@graph": [
    {
      "@id": "https://github.com/solnaeum/practice/ontology",
      "@type": "owl:Ontology",
      "rdfs:label": "거인 이야기 온톨로지",
      "rdfs:comment": "「진격의 거인」과 「걸리버 여행기」 정리 문서(attack_on_titan_imdb.md, gullivers_travels_giants.md)를 schema.org 어휘로 옮긴 그래프. schema.org에 없는 개념만 giant: 네임스페이스로 정의한다."
    },

    {
      "@id": "giant:FictionalCharacter",
      "@type": "rdfs:Class",
      "rdfs:label": "등장인물",
      "rdfs:subClassOf": {"@id": "schema:Person"},
      "rdfs:comment": "작품 속 인물. schema:character의 값으로 쓰기 위해 schema:Person을 확장한다."
    },
    {
      "@id": "giant:FictionalPlace",
      "@type": "rdfs:Class",
      "rdfs:label": "가상의 장소",
      "rdfs:subClassOf": {"@id": "schema:Place"}
    },
    {
      "@id": "giant:FictionalOrganization",
      "@type": "rdfs:Class",
      "rdfs:label": "가상의 조직",
      "rdfs:subClassOf": {"@id": "schema:Organization"}
    },
    {
      "@id": "giant:Species",
      "@type": "rdfs:Class",
      "rdfs:label": "종족",
      "rdfs:subClassOf": {"@id": "schema:Thing"},
      "rdfs:comment": "작품 속 종족. 거인인지, 사람과 비교한 크기를 함께 기록한다."
    },
    {
      "@id": "giant:Theme",
      "@type": "rdfs:Class",
      "rdfs:label": "주제",
      "rdfs:subClassOf": {"@id": "schema:Thing"}
    },

    {
      "@id": "giant:hasTheme",
      "@type": "rdf:Property",
      "rdfs:label": "주제",
      "rdfs:subPropertyOf": {"@id": "schema:about"},
      "schema:domainIncludes": {"@id": "schema:CreativeWork"},
      "schema:rangeIncludes": {"@id": "giant:Theme"}
    },
    {
      "@id": "giant:species",
      "@type": "rdf:Property",
      "rdfs:label": "종족",
      "schema:domainIncludes": {"@id": "giant:FictionalCharacter"},
      "schema:rangeIncludes": {"@id": "giant:Species"}
    },
    {
      "@id": "giant:inhabits",
      "@type": "rdf:Property",
      "rdfs:label": "사는 곳",
      "schema:domainIncludes": {"@id": "giant:Species"},
      "schema:rangeIncludes": {"@id": "giant:FictionalPlace"}
    },
    {
      "@id": "giant:isGiant",
      "@type": "rdf:Property",
      "rdfs:label": "거인 여부",
      "schema:domainIncludes": {"@id": "giant:Species"},
      "schema:rangeIncludes": {"@id": "schema:Boolean"}
    },
    {
      "@id": "giant:scaleRelativeToHuman",
      "@type": "rdf:Property",
      "rdfs:label": "사람 대비 크기",
      "rdfs:comment": "보통 사람의 키를 1로 볼 때의 배율.",
      "schema:domainIncludes": {"@id": "giant:Species"},
      "schema:rangeIncludes": {"@id": "schema:Number"}
    },
    {
      "@id": "giant:voicedBy",
      "@type": "rdf:Property",
      "rdfs:label": "성우",
      "schema:domainIncludes": {"@id": "giant:FictionalCharacter"},
      "schema:rangeIncludes": {"@id": "schema:Person"}
    },
    {
      "@id": "giant:japaneseVoice",
      "@type": "rdf:Property",
      "rdfs:label": "일본어 성우",
      "rdfs:subPropertyOf": {"@id": "giant:voicedBy"}
    },
    {
      "@id": "giant:englishVoice",
      "@type": "rdf:Property",
      "rdfs:label": "영어 더빙 성우",
      "rdfs:subPropertyOf": {"@id": "giant:voicedBy"}
    },
    {
      "@id": "giant:memberOf",
      "@type": "rdf:Property",
      "rdfs:label": "소속",
      "rdfs:subPropertyOf": {"@id": "schema:memberOf"},
      "schema:domainIncludes": {"@id": "giant:FictionalCharacter"},
      "schema:rangeIncludes": {"@id": "giant:FictionalOrganization"}
    },
    {
      "@id": "giant:comparableTo",
      "@type": ["rdf:Property", "owl:SymmetricProperty"],
      "rdfs:label": "비교 대상",
      "rdfs:comment": "두 작품을 나란히 비교할 수 있음을 나타낸다. 대칭 관계.",
      "schema:domainIncludes": {"@id": "schema:CreativeWork"},
      "schema:rangeIncludes": {"@id": "schema:CreativeWork"}
    },

