{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare 대시보드의 Worker 이름과 같아야 Workers Builds가 배포한다.
  "name": "titan-graph",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  // 첫 페이지(/), /api/*, /mcp 는 Worker가 처리하고, 나머지는 public/ 의 정적 파일을 그대로 내보낸다.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/mcp", "/mcp/*"]
  },
  // 챗봇이 쓰는 Workers AI (무료 플랜: 하루 10,000 뉴런)
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "titan-graph-db",
      "database_id": "a707bc41-726e-4ccc-a1f9-1df212cf6fbd",
      "migrations_dir": "migrations"
    }
  ],
  // 편집 비밀번호 EDIT_PASSWORD 와 AI 쓰기 토큰 MCP_TOKEN 은 대시보드에서 Secret으로 넣는다. 배포할 때 대시보드 값을 유지한다.
  "keep_vars": true
}
